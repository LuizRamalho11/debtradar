# Copie este arquivo para ".env" e preencha os valores.
# O arquivo ".env" NÃO deve ser versionado nem compartilhado.

# Token pessoal do GitHub (opcional, mas recomendado).
# Sem token a API permite apenas 60 requisições por hora.
# Crie em: https://github.com/settings/tokens
GITHUB_TOKEN=

# Modelo do spaCy usado na análise (o corpus é em inglês).
SPACY_MODEL=en_core_web_sm

# Quantidade de issues sugerida quando o programa pergunta (Enter aceita).
DEFAULT_ISSUES=100
